{
  "info": {
    "_postman_id": "b6a4a3d0-1a2b-4c3d-9e0f-a1b2c3d4e5f6",
    "name": "Advantage Online Shopping - Search API",
    "description": "Coleção Postman implementando os cenários de teste descritos em advantageonlineshopping-search-api-test-scenarios.pt.md para o endpoint GET /catalog/api/v1/products/search.\n\nOs cenários foram simplificados para refletir regras de negócio, e não validações unitárias isoladas: cada request representa uma regra e agrupa as asserções necessárias para verificá-la.\n\nCada request é independente: testes que precisam comparar duas respostas (ex.: case-insensitive, parâmetros extras) buscam sua própria baseline via `pm.sendRequest` dentro do próprio test script, em vez de depender de `pm.collectionVariables` setadas por outra requisição. Qualquer request pode ser executada isoladamente, em qualquer ordem, sem falhas por dependência de execução anterior.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://www.advantageonlineshopping.com/catalog/api/v1/products/search",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Funcionalidade 1: Contrato da API - Schema e Status Codes",
      "item": [
        {
          "name": "Busca valida retorna resposta estruturada e pronta para consumo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?name=tablet",
              "host": ["{{baseUrl}}"],
              "query": [{ "key": "name", "value": "tablet" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 e Content-Type application/json', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "pm.test('Resposta e um array de categorias, cada uma com seus produtos identificados', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.be.an('array').that.is.not.empty;",
                  "    body.forEach((category) => {",
                  "        pm.expect(category).to.have.property('categoryId').that.is.a('number');",
                  "        pm.expect(category).to.have.property('categoryName').that.is.a('string');",
                  "        pm.expect(category).to.have.property('products').that.is.an('array');",
                  "        category.products.forEach((product) => {",
                  "            pm.expect(product).to.have.property('productId').that.is.a('number');",
                  "            pm.expect(product).to.have.property('productName').that.is.a('string');",
                  "            pm.expect(product).to.have.property('price').that.is.a('number');",
                  "        });",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Campos numericos da resposta tem o tipo correto",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?name=tablet",
              "host": ["{{baseUrl}}"],
              "query": [{ "key": "name", "value": "tablet" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('price e number (nunca string) e categoryId do produto e consistente com a categoria pai', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    body.forEach((category) => {",
                  "        category.products.forEach((product) => {",
                  "            pm.expect(product.price).to.be.a('number');",
                  "            pm.expect(product.categoryId).to.eql(category.categoryId);",
                  "        });",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "[@defeito] Busca sem resultados retorna resposta vazia e nao um erro",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?name=zzzznotfound123",
              "host": ["{{baseUrl}}"],
              "query": [{ "key": "name", "value": "zzzznotfound123" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 com corpo sendo um array JSON vazio', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "    pm.expect(pm.response.json()).to.be.an('array').that.is.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "[@defeito] Ausencia do parametro obrigatorio retorna erro estruturado",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}",
              "host": ["{{baseUrl}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400 com mensagem de erro estruturada em JSON', () => {",
                  "    pm.response.to.have.status(400);",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "    pm.expect(() => pm.response.json()).to.not.throw();",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "[@defeito] Parametro com nome incorreto e tratado como ausencia do parametro obrigatorio",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?term=tablet",
              "host": ["{{baseUrl}}"],
              "query": [{ "key": "term", "value": "tablet" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Parametro name ausente deve retornar 400', () => {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Funcionalidade 2: Busca de Produtos - Casos Funcionais",
      "item": [
        {
          "name": "Busca por termo existente retorna produtos agrupados na categoria correta",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?name=tablet",
              "host": ["{{baseUrl}}"],
              "query": [{ "key": "name", "value": "tablet" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 e categoria TABLETS presente com produtos e precos validos', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    const tablets = body.find((c) => c.categoryName === 'TABLETS');",
                  "    pm.expect(tablets, 'categoria TABLETS').to.not.be.undefined;",
                  "    const names = tablets.products.map((p) => p.productName);",
                  "    ['HP ElitePad 1000 G2 Tablet', 'HP Elite x2 1011 G1 Tablet', 'HP Pro Tablet 608 G1'].forEach((expected) => {",
                  "        pm.expect(names).to.include(expected);",
                  "    });",
                  "    tablets.products.forEach((product) => {",
                  "        pm.expect(product.price, `preco de ${product.productName}`).to.be.a('number').that.is.above(0);",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Busca funciona por termo parcial e e insensivel a maiusculas e minusculas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?name=tab",
              "host": ["{{baseUrl}}"],
              "query": [{ "key": "name", "value": "tab" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Termo parcial tab retorna a categoria TABLETS', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const names = pm.response.json().map((c) => c.categoryName);",
                  "    pm.expect(names).to.include('TABLETS');",
                  "});",
                  "",
                  "pm.test('Busca por TABLET e tablet retornam o mesmo conteudo', (done) => {",
                  "    const baseUrl = pm.collectionVariables.get('baseUrl');",
                  "    pm.sendRequest(`${baseUrl}?name=TABLET`, (errUpper, resUpper) => {",
                  "        pm.expect(errUpper).to.be.null;",
                  "        pm.sendRequest(`${baseUrl}?name=tablet`, (errLower, resLower) => {",
                  "            pm.expect(errLower).to.be.null;",
                  "            pm.expect(resUpper.text()).to.eql(resLower.text());",
                  "            done();",
                  "        });",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Busca com parametro vazio retorna o catalogo completo agrupado por categoria",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?name=",
              "host": ["{{baseUrl}}"],
              "query": [{ "key": "name", "value": "" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status deve ser 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Resposta deve conter multiplas categorias do catalogo', () => {",
                  "    const body = pm.response.json();",
                  "    const names = body.map((c) => c.categoryName);",
                  "    pm.expect(body.length).to.be.greaterThan(1);",
                  "    ['LAPTOPS', 'TABLETS', 'HEADPHONES', 'MICE'].forEach((expected) => {",
                  "        pm.expect(names).to.include(expected);",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Parametros extras sao ignorados sem afetar o resultado",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?name=tablet&foo=bar",
              "host": ["{{baseUrl}}"],
              "query": [
                { "key": "name", "value": "tablet" },
                { "key": "foo", "value": "bar" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Resultado identico ao de uma busca apenas com name=tablet', (done) => {",
                  "    pm.response.to.have.status(200);",
                  "    const baseUrl = pm.collectionVariables.get('baseUrl');",
                  "    pm.sendRequest(`${baseUrl}?name=tablet`, (err, res) => {",
                  "        pm.expect(err).to.be.null;",
                  "        pm.expect(res.text()).to.eql(pm.response.text());",
                  "        done();",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Busca contendo apenas espaco e tratada como busca vazia",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?name=%20",
              "host": ["{{baseUrl}}"],
              "query": [{ "key": "name", "value": "%20" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Comportamento equivalente ao de uma busca com name vazio', (done) => {",
                  "    pm.response.to.have.status(200);",
                  "    const baseUrl = pm.collectionVariables.get('baseUrl');",
                  "    pm.sendRequest(`${baseUrl}?name=`, (err, res) => {",
                  "        pm.expect(err).to.be.null;",
                  "        pm.expect(pm.response.text()).to.eql(res.text());",
                  "        done();",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Funcionalidade 3: Entradas Invalidas, Seguranca e Robustez",
      "item": [
        {
          "name": "Respostas incluem os headers de seguranca obrigatorios",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?name=tablet",
              "host": ["{{baseUrl}}"],
              "query": [{ "key": "name", "value": "tablet" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Headers X-Content-Type-Options, X-Frame-Options e Strict-Transport-Security presentes', () => {",
                  "    pm.expect(pm.response.headers.get('X-Content-Type-Options'), 'X-Content-Type-Options').to.not.be.null;",
                  "    pm.expect(pm.response.headers.get('X-Frame-Options'), 'X-Frame-Options').to.not.be.null;",
                  "    pm.expect(pm.response.headers.get('Strict-Transport-Security'), 'Strict-Transport-Security').to.not.be.null;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "[@defeito] Erros nao expoem detalhes internos da implementacao",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}",
              "host": ["{{baseUrl}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400 e corpo sem stack trace ou detalhes de implementacao', () => {",
                  "    pm.response.to.have.status(400);",
                  "    const text = pm.response.text().toLowerCase();",
                  "    ['exception', 'stack trace', 'tomcat', 'at java.', 'at org.'].forEach((marker) => {",
                  "        pm.expect(text).to.not.include(marker);",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Caracteres Unicode sao aceitos sem erro de encoding",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?name=t\u00e2blet",
              "host": ["{{baseUrl}}"],
              "query": [{ "key": "name", "value": "t\u00e2blet" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 e resposta JSON valida sem erro de encoding', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(() => pm.response.json()).to.not.throw();",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Entrada extremamente longa nao derruba o servico",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('longString', 'a'.repeat(5000));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde com 200, 400 ou 413 de forma controlada (nunca 500) e sem travar', () => {",
                  "    pm.expect([200, 400, 413]).to.include(pm.response.code);",
                  "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?name={{longString}}",
              "host": ["{{baseUrl}}"],
              "query": [{ "key": "name", "value": "{{longString}}" }]
            }
          }
        },
        {
          "name": "[@naofuncional] Politica de cache nao serve resultados desatualizados entre buscas diferentes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?name=tablet",
              "host": ["{{baseUrl}}"],
              "query": [{ "key": "name", "value": "tablet" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Header Cache-Control presente refletindo a politica do endpoint', () => {",
                  "    pm.expect(pm.response.headers.get('Cache-Control')).to.not.be.null;",
                  "});",
                  "",
                  "pm.test('Busca por termo diferente nao reaproveita o resultado anterior', (done) => {",
                  "    const baseUrl = pm.collectionVariables.get('baseUrl');",
                  "    pm.sendRequest(`${baseUrl}?name=laptop`, (err, res) => {",
                  "        pm.expect(err).to.be.null;",
                  "        pm.expect(res.text()).to.not.eql(pm.response.text());",
                  "        done();",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
