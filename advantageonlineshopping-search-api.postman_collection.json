                  "pm.test('Categoria TABLETS deve ser retornada para o termo parcial tab', () => {",
                  "    const body = pm.response.json();",
                  "    const names = body.map((c) => c.categoryName);",
                  "    pm.expect(names).to.include('TABLETS');",
                  "});"
