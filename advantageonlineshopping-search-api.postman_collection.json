    {
      "name": "Funcionalidade 2: Busca de Produtos - Casos Funcionais",
      "item": [
        {
          "name": "Buscar por um termo existente retorna produtos da categoria correta",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?name=tablet",
              "host": ["{{baseUrl}}"],
              "query": [{ "key": "name", "value": "tablet" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status deve ser 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const tablets = body.find((c) => c.categoryName === 'TABLETS');",
                  "",
                  "pm.test('Resposta deve conter a categoria TABLETS', () => {",
                  "    pm.expect(tablets).to.not.be.undefined;",
                  "});",
                  "",
                  "pm.test('Categoria TABLETS deve conter os produtos esperados', () => {",
                  "    const names = tablets.products.map((p) => p.productName);",
                  "    pm.expect(names).to.include('HP ElitePad 1000 G2 Tablet');",
                  "    pm.expect(names).to.include('HP Elite x2 1011 G1 Tablet');",
                  "    pm.expect(names).to.include('HP Pro Tablet 608 G1');",
                  "});"
                ]
              }
            }
          ]
        },
