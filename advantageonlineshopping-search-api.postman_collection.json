          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Header X-Content-Type-Options deve ser nosniff', () => {",
                  "    pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff');",
                  "});",
                  "",
                  "pm.test('Header X-Frame-Options deve ser DENY', () => {",
                  "    pm.expect(pm.response.headers.get('X-Frame-Options')).to.eql('DENY');",
                  "});",
                  "",
                  "pm.test('Header Strict-Transport-Security deve estar presente', () => {",
                  "    pm.expect(pm.response.headers.get('Strict-Transport-Security')).to.not.be.null;",
                  "});"
                ]
              }
            }
          ]
        },
