    "description": "Coleção Postman implementando os cenários de teste descritos em advantageonlineshopping-search-api-test-scenarios.pt.md para o endpoint GET /catalog/api/v1/products/search.\n\nCada request é independente: testes que precisam comparar duas respostas (ex.: case-insensitive, parâmetros extras) buscam sua própria baseline via `pm.sendRequest` dentro do próprio test script, em vez de depender de `pm.collectionVariables` setadas por outra requisição. Qualquer request pode ser executada isoladamente, em qualquer ordem, sem falhas por dependência de execução anterior.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://www.advantageonlineshopping.com/catalog/api/v1/products/search",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Funcionalidade 1: Contrato da API - Schema e Status Codes",
      "item": [
        {
          "name": "Requisicao valida retorna status 200 e Content-Type JSON",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?name=tablet",
              "host": ["{{baseUrl}}"],
              "query": [{ "key": "name", "value": "tablet" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status HTTP deve ser 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Header Content-Type deve estar presente e conter application/json', () => {",
                  "    const contentType = pm.response.headers.get('Content-Type');",
                  "    pm.expect(contentType).to.not.be.null;",
                  "    pm.expect(contentType).to.include('application/json');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Corpo da resposta segue o schema esperado (array de categorias)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?name=tablet",
              "host": ["{{baseUrl}}"],
              "query": [{ "key": "name", "value": "tablet" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Corpo da resposta deve ser um array JSON', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Cada categoria e produto contem os campos esperados', () => {",
                  "    const body = pm.response.json();",
                  "    body.forEach((category) => {",
                  "        pm.expect(category).to.have.property('categoryId').that.is.a('number');",
                  "        pm.expect(category).to.have.property('categoryName').that.is.a('string');",
                  "        pm.expect(category).to.have.property('categoryImageId').that.is.a('string');",
                  "        pm.expect(category).to.have.property('products').that.is.an('array');",
                  "        category.products.forEach((product) => {",
                  "            pm.expect(product).to.have.property('productId').that.is.a('number');",
                  "            pm.expect(product).to.have.property('categoryId').that.is.a('number');",
                  "            pm.expect(product).to.have.property('productName').that.is.a('string');",
                  "            pm.expect(product).to.have.property('price').that.is.a('number');",
                  "            pm.expect(product).to.have.property('imageUrl').that.is.a('string');",
                  "        });",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "O tipo de dado do campo price e numerico e nao uma string",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?name=tablet",
              "host": ["{{baseUrl}}"],
              "query": [{ "key": "name", "value": "tablet" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Campo price de cada produto e number, nunca string', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    body.forEach((category) => {",
                  "        category.products.forEach((product) => {",
                  "            pm.expect(product.price).to.be.a('number');",
                  "        });",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
